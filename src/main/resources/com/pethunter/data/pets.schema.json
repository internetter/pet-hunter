{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pet Hunter dataset",
  "type": "object",
  "required": ["schemaVersion", "pets"],
  "additionalProperties": false,
  "properties": {
    "_comment": {
      "type": "string",
      "description": "Free-text note for dataset maintainers. Ignored by the plugin."
    },
    "schemaVersion": { "type": "integer", "const": 1 },
    "gameUpdateChecked": {
      "type": "string",
      "description": "ISO date the dataset was last reconciled against the live game.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "pets": {
      "type": "array",
      "items": { "$ref": "#/definitions/pet" }
    }
  },
  "definitions": {
    "sourceList": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "description": "URLs backing every numeric value on this object."
    },
    "pet": {
      "type": "object",
      "required": ["id", "name", "category", "obtainableOn", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string" },
        "itemId": { "type": ["integer", "null"] },
        "category": {
          "enum": ["SKILLING", "BOSS", "MINIGAME", "CLUE", "RAID", "SLAYER", "QUEST", "OTHER"]
        },
        "skill": {
          "type": ["string", "null"],
          "description": "Required when any source uses SKILL_LEVEL_SCALED or STATIC_IGNORES_FORMULA."
        },
        "collectionLogPage": { "type": ["string", "null"] },
        "obtainableOn": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["MAIN", "IRONMAN", "HARDCORE", "ULTIMATE", "GROUP"] }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/source" }
        },
        "methods": {
          "type": "array",
          "items": { "$ref": "#/definitions/method" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "label", "rateModel", "verified", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$" },
        "label": { "type": "string" },
        "rateModel": {
          "enum": [
            "FLAT_PER_KILL",
            "FLAT_PER_ROLL",
            "SKILL_LEVEL_SCALED",
            "STATIC_IGNORES_FORMULA",
            "CONTRIBUTION_SCALED",
            "UNIQUE_CONDITIONAL",
            "ONE_OFF"
          ]
        },
        "baseChance": {
          "type": ["integer", "null"],
          "description": "B in 1/(B - level*25). Mutually exclusive with flatRate.",
          "minimum": 1
        },
        "flatRate": {
          "type": ["integer", "null"],
          "description": "Denominator of a fixed 1/N rate. Mutually exclusive with baseChance.",
          "minimum": 1
        },
        "contributionRange": {
          "type": ["array", "null"],
          "description": "[denominator at minimum contribution, denominator at maximum contribution] for CONTRIBUTION_SCALED.",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2
        },
        "minLevel": { "type": ["integer", "null"], "minimum": 1, "maximum": 99 },
        "counterKey": {
          "type": ["string", "null"],
          "description": "Key for the automatic attempt counter. Null forces UNKNOWN or manual entry."
        },
        "verified": { "type": "boolean" },
        "sources": { "$ref": "#/definitions/sourceList" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "method": {
      "type": "object",
      "required": ["id", "verified", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
          "description": "Must match a source.id on the same pet."
        },
        "actionsPerHour": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "xpPerAction": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "requirements": { "type": "array", "items": { "type": "string" } },
        "xpEfficient": {
          "type": ["boolean", "null"],
          "description": "True if this method is also a reasonable way to train the skill."
        },
        "verified": { "type": "boolean" },
        "sources": { "$ref": "#/definitions/sourceList" },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
